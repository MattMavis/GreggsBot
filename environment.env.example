DISCORD_TOKEN=
WCL_TOKEN=
PREFIX=!
API=
BOT_CHAN=

# Optional
GUILD_NAME=Greggs
GUILD_REALM=Draenor
GUILD_REGION=EU
# wowutils.com raid calendar: group API key (group Settings > API Access)
WOWUTILS_KEY=
# Channel id for raid reminders, role name to ping, and when to remind:
# a time on the raid day (14:00) and/or hours before the start (1)
RAID_CHANNEL=
RAID_ROLE=
RAID_REMIND=14:00,1
# Channel id that direct messages sent to the bot are copied into. Empty = DMs are ignored
DM_LOG_CHANNEL=
# Roster ranks the loot council is drawn from, separated by commas. Empty = everyone
LOOT_COUNCIL_RANKS=Raider
# Optional: replace the reminder texts. {link} becomes the raid planning hub link.
# A custom server emoji is written <:name:id> (type \:name: in Discord to get it).
RAID_DAY_MESSAGE=
RAID_HOUR_MESSAGE=
# Setup number used in the planning hub link
RAID_SETUP_ID=1
# IANA name, e.g. Europe/London. Empty = machine local time
REMINDER_TZ=
# Raider.IO raid slug to pin for !rank, e.g. tier-mn-1. Empty = newest raid
RAID=
